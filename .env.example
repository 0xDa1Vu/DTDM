# Cấu hình DTDM Docker demo. Chạy bằng: bash scripts/demo.sh up -d
# Website trên máy host: 8010; Apache trong container: 80.
APP_URL=http://localhost:8010
APP_ENV=local

# MongoDB chạy trong Docker, không phải MongoDB trên localhost của macOS.
CATALOG_DRIVER=mongodb
MONGODB_URI=mongodb://mongo1:27017,mongo2:27017,mongo3:27017/?replicaSet=rsCatalog
MONGODB_DATABASE=catalog_demo
CAP_DEMO_ENABLED=0
# CAP chỉ được bật rõ ràng bởi docker-compose.demo.yml.

# MySQL nội bộ Docker demo; không dùng database XAMPP của project cũ.
DB_HOST=db
DB_PORT=3306
DB_NAME=catalog_demo
DB_USER=demo
DB_PASS=demo_local_only

# VNPay sandbox — lấy tại https://sandbox.vnpayment.vn/
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:8010/payment/vnpay/return

# SePay — chuyển khoản QR (https://sepay.vn). Cấu hình webhook trỏ về /payment/sepay/webhook
SEPAY_ACCOUNT_NUMBER=0123456789
SEPAY_BANK=MBBank
SEPAY_ACCOUNT_NAME=CUA HANG ATELIER
SEPAY_API_KEY=
SEPAY_PREFIX=DH
